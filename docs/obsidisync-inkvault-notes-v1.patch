+        )
+        .await
+        .is_err());
+    // Fixed source inputs render exactly the same bytes.
+    let pdf2 = service
+        .file_bytes_at_version(
+            "alice",
+            "notes",
+            "Notes/Test.pdf",
+            second.server_head.as_ref().unwrap(),
+        )
